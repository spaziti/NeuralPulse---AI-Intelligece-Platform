# NeuralPulse - Configuration Settings

# General App Environment
APP_ENV=development
APP_NAME=NeuralPulse
DEBUG=true

# FastAPI Backend Config
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# Next.js Frontend Config
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws

# PostgreSQL Database Config
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=neuralpulse_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_password@postgres:5432/neuralpulse_db

# Redis Config (Cache, WebSockets, Celery Broker)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ChromaDB Config (Vector Store)
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=news_embeddings

# Security / Authentication
JWT_SECRET=generate_a_secure_random_hex_key_in_production_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers (for AI Agents)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
